# Export the selected compiler, code profile and OpenMP runtime for Python-built
# launcher fixtures. OpenMP compilation switches are deliberately separate from
# explicit runtime libraries: g++ -fopenmp at link time adds libgomp even when
# production was configured to link libomp through OpenMP::OpenMP_CXX.
function(findhap_fixture_json_string output value)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    string(REPLACE "\t" "\\t" value "${value}")
    set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()
function(findhap_fixture_json_array output)
    set(items "")
    foreach(value IN LISTS ARGN)
        findhap_fixture_json_string(quoted "${value}")
        if(items)
            string(APPEND items ",")
        endif()
        string(APPEND items "${quoted}")
    endforeach()
    set(${output} "[${items}]" PARENT_SCOPE)
endfunction()
get_directory_property(findhap_fixture_definitions COMPILE_DEFINITIONS)
get_target_property(findhap_fixture_link_options findhap LINK_OPTIONS)
if(NOT findhap_fixture_link_options)
    set(findhap_fixture_link_options "")
endif()
findhap_fixture_json_string(findhap_fixture_compiler "${CMAKE_CXX_COMPILER}")
findhap_fixture_json_string(findhap_fixture_common "${CMAKE_CXX_FLAGS}")
findhap_fixture_json_string(findhap_fixture_openmp "${OpenMP_CXX_FLAGS}")
findhap_fixture_json_string(findhap_fixture_link_flags "${CMAKE_EXE_LINKER_FLAGS}")
findhap_fixture_json_array(findhap_fixture_defs ${findhap_fixture_definitions})
findhap_fixture_json_array(findhap_fixture_includes ${OpenMP_CXX_INCLUDE_DIRS})
findhap_fixture_json_array(findhap_fixture_libraries ${OpenMP_CXX_LIBRARIES})
findhap_fixture_json_array(findhap_fixture_links ${findhap_fixture_link_options})
set(findhap_fixture_configurations Debug Release RelWithDebInfo MinSizeRel ${CMAKE_BUILD_TYPE} ${CMAKE_CONFIGURATION_TYPES})
list(REMOVE_DUPLICATES findhap_fixture_configurations)
set(findhap_fixture_config_flags "")
foreach(config IN LISTS findhap_fixture_configurations)
    string(TOUPPER "${config}" upper)
    findhap_fixture_json_string(quoted "${CMAKE_CXX_FLAGS_${upper}}")
    # Remove surrounding JSON quotes so each selected configuration contributes
    # exactly one string, with its inner escaping preserved.
    string(LENGTH "${quoted}" length)
    math(EXPR length "${length} - 2")
    string(SUBSTRING "${quoted}" 1 ${length} escaped)
    string(APPEND findhap_fixture_config_flags "$<$<CONFIG:${config}>:${escaped}>")
endforeach()
set(findhap_fixture_config "${CMAKE_CURRENT_BINARY_DIR}/fixture-build-$<CONFIG>.json")
file(GENERATE OUTPUT "${findhap_fixture_config}" CONTENT
"{\n\"compiler\":${findhap_fixture_compiler},\n\"common_flags\":${findhap_fixture_common},\n\"configuration_flags\":\"${findhap_fixture_config_flags}\",\n\"compile_definitions\":${findhap_fixture_defs},\n\"openmp_compile_flags\":${findhap_fixture_openmp},\n\"openmp_include_dirs\":${findhap_fixture_includes},\n\"openmp_libraries\":${findhap_fixture_libraries},\n\"executable_link_flags\":${findhap_fixture_link_flags},\n\"link_options\":${findhap_fixture_links}\n}\n")
set(FINDHAP_TEST_BUILD_ENV "CXX=${CMAKE_CXX_COMPILER};FINDHAP_TEST_BUILD_CONFIG=${findhap_fixture_config}")
