# A CPU name and an ISA are separate facts. Keep measured compiler defaults
# until a build with a previously unrecognised model is qualified on that host.
set(turbohap_effective_flags "${CMAKE_CXX_FLAGS} ${CMAKE_CXX_FLAGS_RELEASE}")
set(turbohap_profile_reason "compiler-target policy")
if(FINDHAP_PORTABLE_BUILD OR CMAKE_CROSSCOMPILING OR NOT turbohap_can_probe_host)
    set(turbohap_profile_reason "declared target; build host excluded")
elseif(FINDHAP_QUALIFIED_APPLE_M4)
    set(turbohap_profile_reason "native M4 Pro")
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND (turbohap_effective_flags MATCHES "(^|[ \t])-(march|mcpu)=native([ \t]|$)" OR
        (turbohap_host_model STREQUAL "orin" AND turbohap_effective_flags MATCHES "(^|[ \t])-mcpu=cortex-a78ae([ \t]|$)")))
    set(turbohap_profile_reason "native target; shared architecture defaults")
    if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64)$")
        # Compare to the integrated GCC route before changing a measured default.
        set(legacy_profile unknown)
        if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
            execute_process(COMMAND ${CMAKE_CXX_COMPILER} -march=native "-###" -c -x c++ /dev/null
                ERROR_VARIABLE driver OUTPUT_VARIABLE driver_out RESULT_VARIABLE driver_status)
            if(driver_status EQUAL 0 AND "${driver_out}${driver}" MATCHES "-mcpu=neoverse-v2([+ \"]|$)")
                set(legacy_profile axion)
            elseif(turbohap_host_model STREQUAL "gb10" OR
                    (driver_status EQUAL 0 AND driver MATCHES "-mcpu=gb10([+ \"]|$)"))
                set(legacy_profile gb10)
            endif()
        endif()
        set(active_profile "${legacy_profile}")
        if(FINDHAP_TRY_CPU_PROFILE OR turbohap_default_spark_clang OR
                (turbohap_host_model MATCHES "^(axion-n3|orin)$" AND CMAKE_CXX_COMPILER_ID MATCHES "^(GNU|Clang)$"))
            set(active_profile "${turbohap_host_model}")
        endif()
        if(active_profile MATCHES "^(gb10|axion|axion-n3|orin)$" AND " ${turbohap_host_features} " MATCHES " neon ")
            turbohap_check_recipe("${CMAKE_CXX_FLAGS_RELEASE}" "${turbohap_arm_test}" isa_ok)
            if(isa_ok)
                if(active_profile STREQUAL "gb10")
                    add_compile_definitions(FINDHAP_NATIVE_GB10=1)
                elseif(active_profile STREQUAL "axion-n3")
                    add_compile_definitions(FINDHAP_NATIVE_NEOVERSE_N3=1)
                elseif(active_profile STREQUAL "orin")
                    add_compile_definitions(FINDHAP_NATIVE_TEGRA234=1)
                else()
                    add_compile_definitions(FINDHAP_NATIVE_NEOVERSE_V2=1)
                endif()
                set(turbohap_profile_reason "linked NEON; CPU=${turbohap_host_model}, previous=${legacy_profile}, selected=${active_profile}")
            elseif(active_profile STREQUAL "orin")
                set(turbohap_profile_reason "Jetson Orin detected; NEON/OpenMP link check failed; using architecture defaults")
            endif()
        elseif(active_profile STREQUAL "orin")
            set(turbohap_profile_reason "Jetson Orin detected; OS did not advertise NEON; using architecture defaults")
        endif()
    elseif(turbohap_host_model MATCHES "^(granite|ice|sapphire|emerald|cascade|turin|genoa|milan)$")
        # All required instructions must be exposed by the VM/OS and accepted under the actual flags.
        set(required avx2)
        if(NOT turbohap_host_model STREQUAL "milan")
            list(APPEND required bmi2 avx512f avx512bw)
        endif()
        if(turbohap_host_model MATCHES "^(granite|ice|sapphire|emerald|turin|genoa)$")
            list(APPEND required vbmi)
        endif()
        if(turbohap_host_model STREQUAL "turin")
            list(APPEND required vp2intersect)
        endif()
        string(REPLACE " " ";" available "${turbohap_host_features}")
        set(isa_ok TRUE)
        foreach(feature IN LISTS required)
            if(NOT feature IN_LIST available)
                set(isa_ok FALSE)
            endif()
        endforeach()
        if(isa_ok)
            string(TOUPPER "${turbohap_host_model}" model_macro)
            file(READ "${CMAKE_CURRENT_LIST_DIR}/X86KernelProbe.cpp" probe)
            turbohap_check_recipe("${CMAKE_CXX_FLAGS_RELEASE}"
                "#define FINDHAP_PROBED_${model_macro} 1\n${probe}" isa_ok)
        endif()
        if(isa_ok)
            set(turbohap_profile_reason "native x86 identity and kernels verified; existing compiler policy")
            if(FINDHAP_TRY_CPU_PROFILE)
                add_compile_definitions("FINDHAP_PROBED_${model_macro}=1")
                set(turbohap_profile_reason "native x86 identity and kernels verified; qualification override")
            elseif(turbohap_host_model STREQUAL "genoa")
                add_compile_definitions(FINDHAP_PROBED_GENOA=1)
                set(turbohap_profile_reason "native Genoa identity and shared EPYC kernels verified")
            elseif(turbohap_host_model STREQUAL "emerald")
                # GCC 13 can tune this CPU as Sapphire Rapids. Use the actual
                # host identity once the compiler and OS pass the ISA checks.
                add_compile_definitions(FINDHAP_PROBED_EMERALD=1)
                set(turbohap_profile_reason "native Emerald Rapids identity and shared Xeon kernels verified")
            endif()
        else()
            set(turbohap_profile_reason "processor recognised; required native feature or kernel probe unavailable")
        endif()
    endif()
endif()
if(FINDHAP_TRY_CPU_PROFILE AND NOT turbohap_profile_reason MATCHES "qualification override|linked NEON")
    message(FATAL_ERROR "Cannot qualify this native processor profile: ${turbohap_profile_reason}")
endif()
message(STATUS "TurboHap CPU: ${turbohap_host_identity} [${turbohap_host_model}]; ${turbohap_profile_reason}")
